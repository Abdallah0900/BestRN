<footer>Nursing Internship — Hospital Medication Handbook · مرجع تعليمي، المرجع النهائي دايمًا: Prescriber Order + Product Information + Hospital Protocol.</footer>

<script>
const mcqData = [
 {q:"مريض أخد Paracetamol من بره المستشفى، ومكتوب له جرعة تانية IV. أول حاجة تتأكدي منها؟", opts:["لون الدواء","إجمالي الجرعة في آخر 24 ساعة","رأي المريض بس","سرعة الإعطاء"], c:1, why:"أشهر خطأ مع Paracetamol هو ازدواج الجرعة من مصادر مختلفة."},
 {q:"مريض قلب على Normal Saline IV، وبدأ يظهر ضيق نفس وخشخشة في الرئة. السبب المحتمل؟", opts:["حساسية من الملح","Fluid Overload","نقص سكر","عدوى"], c:1, why:"كمية أو سرعة سوائل أعلى من طاقة القلب بتسبب Fluid Overload."},
 {q:"إيه الممنوع تخلطه مع Ceftriaxone في نفس الخط؟", opts:["Normal Saline","محاليل فيها كالسيوم (Ringer's, TPN)","الماء المقطر","D5W"], c:1, why:"خطر ترسيب خطير، وقاتل عند حديثي الولادة."},
 {q:"مريض على Furosemide وDigoxin، وبوتاسيومه منخفض. الخطر الأساسي؟", opts:["زيادة الوزن","تسمم الديجوكسين", "حساسية جلد","إمساك"], c:1, why:"هبوط البوتاسيوم بيزود خطر تسمم الديجوكسين بشكل كبير."},
 {q:"سكر مريض قبل جرعة Insulin كان 65 mg/dL. تعملي إيه؟", opts:["تدّي الجرعة كاملة","توقفي الجرعة وتتصرفي مع هبوط السكر","تنصّي الجرعة","تسجلي وتكملي"], c:1, why:"متدّيش إنسولين على سكر منخفض — لازم تعالجي الهبوط الأول."}
];
let mcqScore = 0;
const mcqHolder = document.getElementById('mcqHolder');
mcqData.forEach(function(item, qi){
  const card = document.createElement('div'); card.className = 'q-card';
  let optsHtml = '<div class="q-opts">';
  item.opts.forEach(function(opt, oi){ optsHtml += '<button class="q-opt" data-oi="'+oi+'">'+opt+'</button>'; });
  optsHtml += '</div><div class="q-why">'+item.why+'</div>';
  card.innerHTML = '<div class="q-text">'+(qi+1)+'. '+item.q+'</div>'+optsHtml;
  mcqHolder.appendChild(card);
  card.querySelectorAll('.q-opt').forEach(function(btn){
    btn.addEventListener('click', function(){
      if(card.dataset.locked) return; card.dataset.locked = '1';
      const oi = parseInt(btn.dataset.oi,10);
      card.querySelectorAll('.q-opt').forEach(function(b){b.setAttribute('disabled','');});
      if(oi === item.c){ btn.classList.add('correct'); mcqScore++; }
      else { btn.classList.add('incorrect'); card.querySelector('[data-oi="'+item.c+'"]').classList.add('correct'); }
      card.querySelector('.q-why').classList.add('show');
      document.getElementById('mcqScoreText').textContent = mcqScore+' / '+mcqData.length;
    });
  });
});
</script>
